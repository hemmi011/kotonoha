<div class="max-w-6xl mx-auto px-4 py-6">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <%# 左カラム: 木と投稿フォーム %>
    <div class="lg:col-span-2 space-y-5">
      <div class="bg-white rounded-2xl shadow-sm border border-emerald-100 p-6">
        <h1 class="text-xl font-bold text-slate-800"><%= @event.title %></h1>
        <p class="mt-2 text-sm text-slate-500">
          <%= @event.start_at.strftime("%Y/%m/%d (%a) %H:%M") if @event.start_at.present? %>
        </p>
        <p class="mt-1 text-sm text-emerald-700">
          🌿 みんなの一言で、この木を育てよう
        </p>

        <%# 木のイラスト（画像は app/assets/images/tree.png に置く） %>
        <div class="mt-4 flex justify-center bg-gradient-to-b from-sky-50 to-emerald-50 rounded-xl py-6">
        </div>

        <%# 投稿数と成長度 %>
        <%# 成長度: 投稿1件につき10パーゼンと、上限100パーセント。ルールを変えるときはここの7を直す %>
        <% growth = [@posts.size * 10, 100].min %>
        <div class="mt-4 flex items-center gap-4">
          <span class="text-sm text-slate-600 whitespace-nowrap">🌿 <%= @posts.size %>件の投稿</span>
          <div class="flex-1 h-3 bg-emerald-100 rounded-full overflow-hidden">
        <%# 幅だけstyleで書く理由: Tailwindは実行時に変わるクラス名（w-[...]）をCSSにできないため %>
            <div class="h-full bg-emerald-600 rounded-full" style="width: <%= growth %>%"></div>
          </div>
          <span class="text-sm text-slate-600 whitespace-nowrap">成長度 <%= growth %>%</span>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-emerald-100 p-6">
        <h2 class="text-base font-bold text-slate-800 mb-3">今日学んだこと・気づいたことを一言で！</h2>
        <%= render 'posts/form', post: @post, event: @event %>
      </div>
    </div>

    <%# 右カラム: みんなの学び %>
    <div class="bg-white rounded-2xl shadow-sm border border-emerald-100 p-6 h-fit">
      <h2 class="text-base font-bold text-slate-800 mb-4">みんなの学び</h2>
      <div class="divide-y divide-slate-100">
        <%= render @posts %>
      </div>
    </div>

  </div>
</div>