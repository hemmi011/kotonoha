<div class="min-h-screen bg-[#fcfdf9] px-6 py-16">
  <div class="mx-auto max-w-md">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-semibold tracking-wide text-[#205c45]">
        ユーザー登録
      </h1>

      <p class="mt-3 text-sm text-[#7c8d87]">
        kotonohaで、みんなと学びを共有しよう。
      </p>
    </div>

    <div class="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-[#e5eee9]">
      <%= form_with model: @user do |f| %>

        <div class="space-y-6">
          <div>
            <%= f.label :name,
                class: "mb-2 block text-sm font-medium text-[#355c4c]" %>

            <%= f.text_field :name,
                class: "w-full rounded-xl border border-[#dce9e2] bg-[#fbfdfb] px-4 py-3 text-sm outline-none transition focus:border-[#4d8b6c] focus:ring-2 focus:ring-[#dcefe3]" %>
          </div>

          <div>
            <%= f.label :email,
                class: "mb-2 block text-sm font-medium text-[#355c4c]" %>

            <%= f.email_field :email,
                class: "w-full rounded-xl border border-[#dce9e2] bg-[#fbfdfb] px-4 py-3 text-sm outline-none transition focus:border-[#4d8b6c] focus:ring-2 focus:ring-[#dcefe3]" %>
          </div>

          <div>
            <%= f.label :password,
                class: "mb-2 block text-sm font-medium text-[#355c4c]" %>

            <%= f.password_field :password,
                class: "w-full rounded-xl border border-[#dce9e2] bg-[#fbfdfb] px-4 py-3 text-sm outline-none transition focus:border-[#4d8b6c] focus:ring-2 focus:ring-[#dcefe3]" %>
          </div>

          <div>
            <%= f.label :password_confirmation,
                class: "mb-2 block text-sm font-medium text-[#355c4c]" %>

            <%= f.password_field :password_confirmation,
                class: "w-full rounded-xl border border-[#dce9e2] bg-[#fbfdfb] px-4 py-3 text-sm outline-none transition focus:border-[#4d8b6c] focus:ring-2 focus:ring-[#dcefe3]" %>
          </div>

          <div class="pt-2">
            <%= f.submit "登録",
                class: "w-full rounded-full bg-[#216448] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#194f38] hover:-translate-y-0.5" %>
          </div>

        </div>
      <% end %>

      <div class="mt-6 text-center">
        <%= link_to "ログインページへ",
            login_path,
            class: "text-sm text-[#4d8068] transition hover:text-[#205c45] hover:underline" %>
      </div>
    </div>

  </div>
</div>