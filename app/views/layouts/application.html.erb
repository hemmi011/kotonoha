<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Kotonoha" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="decsription" content="学びを言葉に、成長を木に。kotonohaは、勉強会やもくもく会で得た学びを共有し、アウトプットの習慣を育てるアプリです。">
    <meta name="theme-color" content="#205c45">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="kotonoha">
    <!-- スマホなどでWebアプリを扱うための設定 -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kotonoha">
    <meta name="mobile-web-app-capable" content="yes">

    <!-- CSRF対策 -->
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- このページだけheadに追加したいものなどを追加できる。必要になったページが追加情報を差し込める  -->
    <%= yield :head %>

    <!-- favicon -->
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <% if logged_in? %>
      <%= render 'shared/header' %>
    <% else %>
      <%= render 'shared/before_login_header' %>
    <% end %>
    <%= render 'shared/flash_message' %>
    <%= yield %>
    <%= render 'shared/footer' %>
  </body>
</html>
