<%= form_with model: post, url: event_posts_path(event), class: "space-y-3" do |f| %>
  <%= f.label :content, class: "sr-only" %>
  <%= f.text_area :content,
        rows: 3,
        placeholder: "例）Railsのルーティングの仕組みがやっと理解できた！",
        class: "w-full rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-400" %>
  <div class="flex justify-end">
    <%= f.submit "投稿する",
          class: "cursor-pointer rounded-lg bg-emerald-600 px-6 py-2 text-sm font-semibold text-white hover:bg-emerald-700 transition" %>
  </div>
<% end %>