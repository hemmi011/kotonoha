<div class="flex gap-3 py-4">
  <%# アイコンの代わりに名前の頭文字 %>
  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold">
    <%= post.user.name.first %>
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-baseline gap-2">
      <span class="text-sm font-semibold text-slate-800"><%= post.user.name %></span>
      <%# 何分前表示 %>
      <span class="text-xs text-slate-400"><%= time_ago_in_words(post.created_at) %>前</span>
    </div>
    <div class="mt-1 text-sm text-slate-700 break-words">
      <%= simple_format(post.content, class: "m-0") %>
    </div>
  </div>
</div>