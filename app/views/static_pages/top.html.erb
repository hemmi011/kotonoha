<div class="min-h-screen bg-[#fcfdf9] flex items-center justify-center px-6">
  <div class="w-full max-w-5xl text-center">
    <!-- Tree image -->
    <div>
        <%= image_tag "tree-top-page.jpg" %>
    </div>

    <!-- Catch copy -->
    <div>
      <h1 class="text-4xl font-semibold tracking-wide text-[#205c45] md:text-5xl">
        学びを重ねて、木を育てよう。
      </h1>

      <p class="mt-6 text-lg tracking-wide text-[#7c8d87] md:text-xl">
        みんなの学びが集まる場所、kotonoha。
      </p>
    </div>

    <!-- CTA -->
    <div class="mt-10">
      <%= link_to "イベントを探す",
          "#",
          class: "inline-flex items-center rounded-full bg-[#216448] px-8 py-3.5 text-sm font-semibold tracking-wide text-white shadow-sm transition hover:bg-[#194f38] hover:-translate-y-0.5" %>
    </div>

  </div>
</div>