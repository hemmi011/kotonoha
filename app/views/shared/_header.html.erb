<header class="relative h-[90px] border border-[#dce9df] bg-[#fcfdf9] shadow-sm overflow-hidden">

  <!-- 左端の葉っぱ装飾 -->
  <div class="pointer-events-none absolute -left-2 -bottom-1 opacity-60">
    <svg
      width="75"
      height="85"
      viewBox="0 0 75 85"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M29 84C31 66 32 49 27 33"
        stroke="#a9d0ae"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        d="M28 50C15 47 6 39 4 28C15 28 25 35 28 50Z"
        fill="#cfe5cf"
      />
      <path
        d="M30 34C27 20 31 9 40 2C46 13 43 25 30 34Z"
        fill="#b9d9bb"
      />
      <path
        d="M30 65C17 65 9 59 6 50C17 49 26 54 30 65Z"
        fill="#d9ebd8"
      />
    </svg>
  </div>

  <!-- 右端の葉っぱ装飾 -->
  <div class="pointer-events-none absolute -right-2 -bottom-1 rotate-180 opacity-60">
    <svg
      width="75"
      height="85"
      viewBox="0 0 75 85"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M29 84C31 66 32 49 27 33"
        stroke="#a9d0ae"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        d="M28 50C15 47 6 39 4 28C15 28 25 35 28 50Z"
        fill="#cfe5cf"
      />
      <path
        d="M30 34C27 20 31 9 40 2C46 13 43 25 30 34Z"
        fill="#b9d9bb"
      />
      <path
        d="M30 65C17 65 9 59 6 50C17 49 26 54 30 65Z"
        fill="#d9ebd8"
      />
    </svg>
  </div>


  <!-- Header本体 -->
  <div class="relative z-10 mx-auto flex h-full max-w-7xl items-center justify-between px-8">

    <!-- Logo -->
    <div class="flex items-center gap-3">

      <!-- 木のロゴ -->
      <div class="flex h-12 w-12 items-center justify-center">
        <svg
          width="46"
          height="46"
          viewBox="0 0 46 46"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- 幹 -->
          <path
            d="M23 43V25"
            stroke="#795c3f"
            stroke-width="3"
            stroke-linecap="round"
          />

          <!-- 枝 -->
          <path
            d="M23 31L15 24"
            stroke="#795c3f"
            stroke-width="2.5"
            stroke-linecap="round"
          />
          <path
            d="M23 28L31 21"
            stroke="#795c3f"
            stroke-width="2.5"
            stroke-linecap="round"
          />

          <!-- 葉 -->
          <ellipse cx="14" cy="21" rx="5" ry="8" fill="#5c9b62" transform="rotate(-40 14 21)"/>
          <ellipse cx="31" cy="18" rx="5" ry="8" fill="#6eaa70" transform="rotate(35 31 18)"/>
          <ellipse cx="23" cy="13" rx="5" ry="8" fill="#80b878"/>
          <ellipse cx="15" cy="11" rx="4" ry="6" fill="#4e9259" transform="rotate(-35 15 11)"/>
          <ellipse cx="32" cy="8" rx="4" ry="6" fill="#76ad70" transform="rotate(35 32 8)"/>
        </svg>
      </div>

      <!-- サイト名 -->
      <div class="text-[28px] font-semibold tracking-[0.08em] text-[#185b40]">
        <%= link_to 'kotonoha', root_path %>
      </div>
    </div>


    <!-- イベント一覧 -->
    <div class="ml-16 flex items-center">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20 4C11 4 5 8 5 15C5 17.8 7.2 20 10 20C17 20 20 13 20 4Z"
            fill="#4d9960"
          />
          <path
            d="M5 20C7 14 11 11 16 8"
            stroke="#2f7046"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
         <%= link_to "イベント一覧", events_path, class: "flex items-center gap-2 text-[15px] font-medium tracking-wide text-[#2f4f40] transition hover:text-[#17613f]" %>
        <!-- 葉っぱアイコン -->
    </div>

    <!-- イベント作成 -->
     <div class="ml-16 flex items-center">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M20 4C11 4 5 8 5 15C5 17.8 7.2 20 10 20C17 20 20 13 20 4Z"
            fill="#4d9960"
          />
          <path
            d="M5 20C7 14 11 11 16 8"
            stroke="#2f7046"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
         <%= link_to "イベント作成", new_event_path, class: "flex items-center gap-2 text-[15px] font-medium tracking-wide text-[#2f4f40] transition hover:text-[#17613f]" %>
        <!-- 葉っぱアイコン -->
    </div>


    <!-- 右側 -->
    <div class="ml-auto flex items-center gap-4">

      <!-- 検索 -->
      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-full text-[#155b42] transition hover:bg-[#edf5ee]"
        aria-label="検索"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="11"
            cy="11"
            r="6.5"
            stroke="currentColor"
            stroke-width="2"
          />
          <path
            d="M16 16L21 21"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>


      <!-- ログイン -->
      <%= link_to 'ログアウト', logout_path, class:"flex h-11 items-center rounded-full border border-[#155b42] px-7 text-sm font-semibold tracking-wide text-[#155b42] transition hover:bg-[#edf5ee]", data: { turbo_method: :delete } %>

     <!-- ユーザー -->
    <div class="flex items-center rounded-full bg-[#f1f8f2] px-5 py-2.5">
      <span class="text-sm font-semibold tracking-wide text-[#2f6b4a]">
        <%= current_user.name %>さん
      </span>
    </div>
      

    </div>

  </div>
</header>