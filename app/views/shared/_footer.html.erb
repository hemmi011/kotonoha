<footer class="relative overflow-hidden border-t border-[#dce9df] bg-[#fcfdf9]">

  <!-- 左下の葉っぱ装飾 -->
  <div class="pointer-events-none absolute -bottom-1 -left-1 opacity-60">
    <svg
      width="75"
      height="90"
      viewBox="0 0 75 90"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M31 90C31 69 31 49 27 31"
        stroke="#a9d0ae"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        d="M28 54C15 51 6 42 4 31C15 31 25 38 28 54Z"
        fill="#cfe5cf"
      />
      <path
        d="M29 38C26 23 30 11 39 4C45 16 42 29 29 38Z"
        fill="#b9d9bb"
      />
      <path
        d="M31 68C18 68 9 61 6 52C17 51 27 57 31 68Z"
        fill="#d9ebd8"
      />
    </svg>
  </div>

  <!-- 右下の葉っぱ装飾 -->
  <div class="pointer-events-none absolute -bottom-1 -right-1 opacity-60">
    <svg
      width="75"
      height="90"
      viewBox="0 0 75 90"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M44 90C44 69 44 49 48 31"
        stroke="#a9d0ae"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        d="M47 54C60 51 69 42 71 31C60 31 50 38 47 54Z"
        fill="#cfe5cf"
      />
      <path
        d="M46 38C49 23 45 11 36 4C30 16 33 29 46 38Z"
        fill="#b9d9bb"
      />
      <path
        d="M44 68C57 68 66 61 69 52C58 51 48 57 44 68Z"
        fill="#d9ebd8"
      />
    </svg>
  </div>

  <!-- Footer本体 -->
  <div class="relative z-10 mx-auto max-w-6xl px-8 pt-8">

    <!-- 上段 -->
    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">

      <!-- Logo -->
      <div class="flex flex-col items-center md:items-start">

        <div class="flex items-center gap-3">
          <!-- 木のロゴ -->
          <div class="flex h-12 w-12 items-center justify-center">
            <svg
              width="44"
              height="44"
              viewBox="0 0 46 46"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <!-- 幹 -->
              <path
                d="M23 43V25"
                stroke="#795c3f"
                stroke-width="3"
                stroke-linecap="round"
              />

              <!-- 枝 -->
              <path
                d="M23 31L15 24"
                stroke="#795c3f"
                stroke-width="2.5"
                stroke-linecap="round"
              />
              <path
                d="M23 28L31 21"
                stroke="#795c3f"
                stroke-width="2.5"
                stroke-linecap="round"
              />

              <!-- 葉 -->
              <ellipse
                cx="14"
                cy="21"
                rx="5"
                ry="8"
                fill="#5c9b62"
                transform="rotate(-40 14 21)"
              />
              <ellipse
                cx="31"
                cy="18"
                rx="5"
                ry="8"
                fill="#6eaa70"
                transform="rotate(35 31 18)"
              />
              <ellipse
                cx="23"
                cy="13"
                rx="5"
                ry="8"
                fill="#80b878"
              />
              <ellipse
                cx="15"
                cy="11"
                rx="4"
                ry="6"
                fill="#4e9259"
                transform="rotate(-35 15 11)"
              />
              <ellipse
                cx="32"
                cy="8"
                rx="4"
                ry="6"
                fill="#76ad70"
                transform="rotate(35 32 8)"
              />
            </svg>
          </div>

          <span class="text-[27px] font-semibold tracking-[0.08em] text-[#185b40]">
            kotonoha
          </span>
        </div>

        <p class="mt-1 ml-[60px] text-xs tracking-[0.12em] text-[#82958c]">
          学びを重ねて、木を育てよう。
        </p>

      </div>

      <!-- ナビゲーション -->
      <nav class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-sm font-medium text-[#31594a]">
        <%= link_to "イベント一覧",
            "#",
            class: "transition hover:text-[#17613f]" %>
      </nav>

      <!-- SNS -->
      <div class="flex items-center gap-5">

        <!-- GitHub -->
        <%= link_to "https://github.com/hemmi011", target: :_blank, rel: "noopener noreferrer",
            class: "flex h-9 w-9 items-center justify-center rounded-full bg-[#185b40] text-white transition hover:-translate-y-0.5 hover:bg-[#124b37]",
            aria: { label: "GitHub" } do %>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M12 2C6.48 2 2 6.58 2 12.24C2 16.77 4.87 20.6 8.84 21.96C9.34 22.06 9.52 21.74 9.52 21.46C9.52 21.21 9.51 20.55 9.5 19.67C6.73 20.29 6.14 18.28 6.14 18.28C5.69 17.08 5.03 16.76 5.03 16.76C4.12 16.12 5.1 16.14 5.1 16.14C6.1 16.22 6.62 17.19 6.62 17.19C7.52 18.77 8.98 18.32 9.54 18.06C9.63 17.4 9.89 16.95 10.18 16.7C7.97 16.44 5.64 15.56 5.64 11.71C5.64 10.61 6.02 9.71 6.63 9.01C6.53 8.76 6.2 7.74 6.72 6.35C6.72 6.35 7.56 6.07 9.48 7.42C10.28 7.19 11.14 7.07 12 7.07C12.86 7.07 13.72 7.19 14.52 7.42C16.44 6.07 17.28 6.35 17.28 6.35C17.8 7.74 17.47 8.76 17.37 9.01C17.98 9.71 18.36 10.61 18.36 11.71C18.36 15.57 16.03 16.43 13.81 16.69C14.17 17.01 14.49 17.63 14.49 18.58C14.49 19.94 14.48 21.04 14.48 21.46C14.48 21.74 14.66 22.07 15.17 21.96C19.13 20.6 22 16.77 22 12.24C22 6.58 17.52 2 12 2Z" />
          </svg>
        <% end %>

        <!-- X -->
        <%= link_to "https://x.com/daitogy", target: :_blank, rel: "noopener noreferrer",
            class: "flex h-9 w-9 items-center justify-center rounded-full bg-[#185b40] text-white transition hover:-translate-y-0.5 hover:bg-[#124b37]",
            aria: { label: "X" } do %>
          <span class="text-sm font-semibold">
            𝕏
          </span>
        <% end %>

        <!-- note -->
        <%= link_to "https://school.runteq.jp/social_portfolios/hemmy0311", target: :_blank, rel: "noopener noreferrer",
            class: "flex h-9 w-9 items-center justify-center rounded-full bg-[#185b40] text-white transition hover:-translate-y-0.5 hover:bg-[#124b37]",
            aria: { label: "note" } do %>
          <span class="text-xs font-bold">
            n
          </span>
        <% end %>

      </div>

    </div>

    <!-- 区切り線 -->
    <div class="mt-8 border-t border-[#d8e3db]"></div>

    <!-- Copyright -->
    <div class="flex h-14 items-center justify-center">
      <p class="text-sm tracking-wide text-[#82958c]">
        © 2026 kotonoha. All rights reserved.
      </p>
    </div>

  </div>

</footer>